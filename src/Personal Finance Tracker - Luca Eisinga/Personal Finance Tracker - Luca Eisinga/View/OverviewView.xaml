<UserControl x:Class="Personal_Finance_Tracker___Luca_Eisinga.View.OverviewView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Personal_Finance_Tracker___Luca_Eisinga.View"
        xmlns:wpf="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Background="White">

    <UserControl.Resources>
        <DropShadowEffect x:Key="DropShadow" 
                      ShadowDepth="3" 
                      Color="Black" 
                      Opacity="0.2" 
                      BlurRadius="10"/>

        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF6BD6FF" Offset="0.0" />
                        <GradientStop Color="#FF1D92D1" Offset="1.0" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.7*" />
            <!-- Left side: 70% -->
            <ColumnDefinition Width="0.3*" />
            <!-- Right side: 30% -->
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <!-- Top: Title and hamburger menu -->
                <RowDefinition Height="100" />
                <!-- Top: summary boxes -->
                <RowDefinition Height="0.4*" />
                <!-- Bottom: bar chart -->
                <RowDefinition Height="0.5*" />
            </Grid.RowDefinitions>

            <!-- HEADER ROW -->
            <DockPanel Grid.Row="0" Background="White">
                <!-- Hamburger menu -->
                <Button Content="☰"
                        FontSize="40"
                        Width="70"
                        Height="70"
                        VerticalAlignment="Center"
                        Click="MenuButton_Click"
                        Margin="0,0,40,0" 
                        Style="{StaticResource RoundedButton}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Overview" Command="{Binding openOverviewCommand}" />
                            <MenuItem Header="Budgets" Command="{Binding openBudgetCommand}" />
                            <MenuItem Header="Settings" Command="{Binding openSettingsCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                    <!-- Title -->
                <TextBlock  Text="Overview"
                            FontSize="50"
                            FontWeight="Bold"
                            VerticalAlignment="Center"
                            Foreground="#333" />
            </DockPanel>

            <!-- Top row: Income / Spent / Balance -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Income Block -->
                <Border Grid.Column="0" Margin="70" Padding="10" CornerRadius="8" Effect="{StaticResource DropShadow}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFB0FFB0" Offset="0" />
                            <GradientStop Color="#FF70D070" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Income" FontSize="20"/>
                        <TextBlock Text="{Binding totalIncome, StringFormat=C}" FontWeight="Bold" FontSize="20"/>
                    </StackPanel>
                </Border>

                <!-- Spend Block -->
                <Border Grid.Column="1" Margin="70" Padding="10" CornerRadius="8" Effect="{StaticResource DropShadow}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFB0B0" Offset="0" />
                            <GradientStop Color="#FFD07070" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Spent"  FontSize="20"/>
                        <TextBlock Text="{Binding totalExpenses, StringFormat=C}" FontWeight="Bold"  FontSize="20"/>
                    </StackPanel>
                </Border>

                <!-- Balance Block -->
                <Border Grid.Column="2" Margin="70" Padding="10" CornerRadius="8" Effect="{StaticResource DropShadow}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF6BD6FF" Offset="0.0" />
                            <GradientStop Color="#FF1D92D1" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Balance"  FontSize="20"/>
                        <TextBlock Text="{Binding balance, StringFormat=C}" FontWeight="Bold"  FontSize="20"/>
                    </StackPanel>
                </Border>
            </Grid>


            <!-- Bar chart -->
            <Border Grid.Row="2" Background="#EEE" Margin="0">
                <wpf:CartesianChart Series="{Binding series}"
                    XAxes="{Binding xAxis}"
                    YAxes="{Binding yAxis}"
                    LegendPosition="Right"
                    Margin="10"
                    Grid.Row="2" />


            </Border>
        </Grid>

        <!-- RIGHT COLUMN -->
        <DockPanel Grid.Column="1" Margin="10 0 0 0">
            <!-- Transaction list button -->
            <Button Content="Go to Transactions"
                Command="{Binding openTransactionlistCommand}"
                DockPanel.Dock="Top" 
                Height="40" Margin="0 0 0 10"
                Style="{StaticResource RoundedButton}"
                Effect="{StaticResource DropShadow}"/>

            <!-- Add transaction button -->
            <Button Content="Add Transaction"
                Command="{Binding openTransactionformCommand}"
                DockPanel.Dock="Bottom"
                Height="40" Margin="0 10 0 0"
                Style="{StaticResource RoundedButton}"
                Effect="{StaticResource DropShadow}"/>
            
            <!-- Add category button -->
            <Button Content="Add category"
                Command="{Binding openCategoryFormCommand}"
                DockPanel.Dock="Bottom"
                Height="40" Margin="0 10 0 0"
                Style="{StaticResource RoundedButton}"
                Effect="{StaticResource DropShadow}"/>

            <!-- Transaction list -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="5" Padding="5" Margin="10">
                <ItemsControl ItemsSource="{Binding recentTransactions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Grid inside for layout -->
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <!-- Date -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Category -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Amount -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Type -->
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding date, StringFormat='{}{0:dd MMM}'}" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding category.name}" Grid.Column="1" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding amount, StringFormat=C}" Grid.Column="2" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding transactionType}" Grid.Column="3" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </DockPanel>
    </Grid>

</UserControl>
